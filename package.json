{
  "name": "marktodo-plugin",
  "version": "0.0.14",
  "description": "Manage todos and projects in plain Markdown, minimal by default and powerful on demand.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "todos",
    "todo",
    "kanban"
  ],
  "author": "Isaiah Centifanto",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.2.2",
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.3",
    "eslint": "^10.10.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.13.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "svelte-dnd-action": "^0.9.49"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/centifanto/MarkTodo-plugin.git"
  }
}
